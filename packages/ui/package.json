{
  "name": "@clash/ui",
  "version": "0.1.0",
  "description": "React binding and editor components. The only game logic here is calls into the engine facade.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --external react,react-dom",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@clash/ai": "workspace:*",
    "@clash/analyzer": "workspace:*",
    "@clash/engine": "workspace:*",
    "@clash/exporter": "workspace:*",
    "@clash/importer": "workspace:*",
    "@clash/plugins": "workspace:*",
    "@clash/renderer": "workspace:*",
    "@clash/rules-engine": "workspace:*",
    "@clash/shared": "workspace:*",
    "@clash/simulation": "workspace:*",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "konva": "^9.3.16",
    "react-konva": "^18.2.10",
    "three": "^0.169.0"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.7",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  }
}
