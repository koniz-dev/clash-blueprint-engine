{
  "name": "@clash/ui",
  "version": "0.1.0",
  "description": "React binding and editor components. The only game logic here is calls into the engine facade.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --external react,react-dom",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@clash/ai": "workspace:*",
    "@clash/analyzer": "workspace:*",
    "@clash/engine": "workspace:*",
    "@clash/exporter": "workspace:*",
    "@clash/importer": "workspace:*",
    "@clash/plugins": "workspace:*",
    "@clash/renderer": "workspace:*",
    "@clash/rules-engine": "workspace:*",
    "@clash/shared": "workspace:*",
    "@clash/simulation": "workspace:*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "konva": "^10.5.0",
    "react-konva": "^19.2.7",
    "three": "^0.186.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
