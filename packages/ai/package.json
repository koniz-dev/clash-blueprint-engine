{
  "name": "@clash/ai",
  "version": "0.1.0",
  "description": "Layout recommendation engine: composes analyzer weak points and attack simulations into concrete, validated improvements.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clash/analyzer": "workspace:*",
    "@clash/engine": "workspace:*",
    "@clash/shared": "workspace:*",
    "@clash/simulation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
