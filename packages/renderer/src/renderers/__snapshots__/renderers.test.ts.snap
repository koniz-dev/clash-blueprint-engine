exports[`mermaidRenderer > matches the Mermaid snapshot 1`] = `
"flowchart TB
  subgraph townhall["Town Hall"]
    n_ent_1["Town Hall (4, 4)"]
  end
  subgraph defense["Defense"]
    n_ent_2["Cannon (0, 0)"]
  end
  %% walls: 2
"
`;

